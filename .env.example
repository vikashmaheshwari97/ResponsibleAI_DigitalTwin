# ============================================================
# Responsible AI Digital Twin - Local Development
# Copy to .env and replace CHANGE_ME values.
# .env is ignored by Git.
# ============================================================

POSTGRES_DB=rai_twin
POSTGRES_USER=rai_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Optional explicit URL. If empty, database_service builds the URL from
# POSTGRES_* values above.
# RAI_DATABASE_URL=postgresql+psycopg://rai_user:CHANGE_ME@127.0.0.1:5433/rai_twin

SANDBOX_ADMIN_TOKEN=CHANGE_ME
SANDBOX_BASE_URL=http://127.0.0.1:8001
OLLAMA_HOST=http://127.0.0.1:11434

# Authentication / RBAC
AUTH_ENABLED=false
AUTH_SESSION_TIMEOUT_MINUTES=60

RAI_ADMIN_USERNAME=admin
RAI_ADMIN_PASSWORD_HASH=
RAI_OPERATOR_USERNAME=operator
RAI_OPERATOR_PASSWORD_HASH=
RAI_AUDITOR_USERNAME=auditor
RAI_AUDITOR_PASSWORD_HASH=
RAI_PARTNER_USERNAME=partner
RAI_PARTNER_PASSWORD_HASH=

# CodeCarbon sustainability telemetry
# Offline mode avoids sending measurements to the CodeCarbon API.
CODECARBON_ENABLED=true
CODECARBON_COUNTRY_ISO_CODE=EST
# machine captures the local machine during each agent stage, including a local
# Ollama process when hardware telemetry is available. Use process for stricter
# Python-process attribution.
CODECARBON_TRACKING_MODE=machine
CODECARBON_MEASURE_POWER_SECS=1
CODECARBON_OUTPUT_DIR=backups/codecarbon

# Backup helper defaults
POSTGRES_CONTAINER=rai-postgres
BACKUP_DIR=backups
